<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fifa_card"
    android:padding="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvPosicao"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/fifa_text_secondary"
        android:textSize="12sp"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/imgFlagClassificacao"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvSelecaoNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/fifa_text"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvPontos"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="@color/fifa_gold"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"/>
    <TextView
        android:id="@+id/tvVitorias"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="@color/fifa_text"
        android:textSize="12sp"
        android:gravity="center"/>
    <TextView
        android:id="@+id/tvEmpates"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="@color/fifa_text"
        android:textSize="12sp"
        android:gravity="center"/>
    <TextView
        android:id="@+id/tvDerrotas"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="@color/fifa_text"
        android:textSize="12sp"
        android:gravity="center"/>
    <TextView
        android:id="@+id/tvSaldo"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:gravity="center"/>
</LinearLayout>